# Single source of truth for the packaged upstream runtime.
#
# Everything in this repository derives from this file: the RPM spec mirrors it
# (scripts/lint.sh fails the build if the two drift), and the portable bundle
# builder reads it directly. To package a new upstream release, update the
# version fields and the five target rows below.
#
# Upstream publishes the runtime only inside the PyPI wheel
# `deepseek-harness-runtime-bin`, and that wheel is per-platform: the wheel tag
# and the payload it contains must match exactly, so each target pins both the
# URL and the SHA256 of the artifact it downloads.

# PyPI release of deepseek-harness-runtime-bin (PEP 440 form, no separators).
DSH_RUNTIME_VERSION=0.1.5rc1

# What the packaged runtime prints for `dsh --version`.
DSH_CLI_VERSION=0.1.5-rc.1

# The same prerelease in RPM form (tilde sorts before the final release) and the
# RPM release number. These two appear in the spec as Version:/Release:.
DSH_RPM_VERSION=0.1.5~rc1
DSH_RPM_RELEASE=1

DSH_PYPI_PROJECT=deepseek-harness-runtime-bin
DSH_UPSTREAM_REPO=https://github.com/deepseek-ai/deepseek-harness
DSH_UPSTREAM_LICENSE=MIT

# Targets: <os>-<arch>, matching the naming used by the packaging scripts.
DSH_TARGETS="linux-x64 linux-arm64 macos-arm64 macos-x64 windows-x64"

# Rows are: <wheel basename>|<sha256>|<url>
# The four non-x64 Linux rows are here so that a contributor can add a target
# without re-discovering URLs; only linux-x64 currently has an RPM spec.

DSH_TARGET_linux_x64="deepseek_harness_runtime_bin-${DSH_RUNTIME_VERSION}-py3-none-manylinux_2_28_x86_64.whl|ad877237382baff4628969a9ebdbfe38486d971b7987c032d0e29775759b5229|https://files.pythonhosted.org/packages/bc/ff/632fddc738effdbc8752f02641aba6eaeb96f820367b8cee68397501948d/deepseek_harness_runtime_bin-${DSH_RUNTIME_VERSION}-py3-none-manylinux_2_28_x86_64.whl"

DSH_TARGET_linux_arm64="deepseek_harness_runtime_bin-${DSH_RUNTIME_VERSION}-py3-none-manylinux_2_28_aarch64.whl|32b7bb7887ea89f12462274d1b21acfafb00d38d94e11a5d7122492f185e4f85|https://files.pythonhosted.org/packages/b0/33/9bb2ad17dc0a48d3641c7dd0bfdb8742333577739b31c70f46356847706a/deepseek_harness_runtime_bin-${DSH_RUNTIME_VERSION}-py3-none-manylinux_2_28_aarch64.whl"

DSH_TARGET_macos_arm64="deepseek_harness_runtime_bin-${DSH_RUNTIME_VERSION}-py3-none-macosx_14_0_arm64.whl|65f20c541a499f08c36ac3bfdafce350ca8c7cc23488c1faf4d9b9524b547156|https://files.pythonhosted.org/packages/ec/2d/04d1871e2e3dc8d4d04a3439e5286d55ae64e31a514ae12e95f3f4c9dfa2/deepseek_harness_runtime_bin-${DSH_RUNTIME_VERSION}-py3-none-macosx_14_0_arm64.whl"

DSH_TARGET_macos_x64="deepseek_harness_runtime_bin-${DSH_RUNTIME_VERSION}-py3-none-macosx_14_0_x86_64.whl|c94e6b7f6339a79fea47cba2d841976d87faabab1fb35e7bb9609d8cde9238d5|https://files.pythonhosted.org/packages/51/f3/624219faa56a6a4883cc8dcdeece5f32c5ee3e4cd3cc65c8b3ccefeb57a0/deepseek_harness_runtime_bin-${DSH_RUNTIME_VERSION}-py3-none-macosx_14_0_x86_64.whl"

DSH_TARGET_windows_x64="deepseek_harness_runtime_bin-${DSH_RUNTIME_VERSION}-py3-none-win_amd64.whl|d031a5ab4919c572fd7e48c7ef19ec8b1896e93d93c44b0937bb958c528f8acf|https://files.pythonhosted.org/packages/a2/0e/4b52e5792a7accb09c70831ad3182efa253e15118c683a49dc66f3cbd83a/deepseek_harness_runtime_bin-${DSH_RUNTIME_VERSION}-py3-none-win_amd64.whl"
